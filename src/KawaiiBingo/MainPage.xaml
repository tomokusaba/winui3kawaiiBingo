<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KawaiiBingo.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KawaiiBingo.ViewModels"
    Background="#FFF5F6">
    <Page.Resources>
        <Style x:Key="DrawButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EA5C8E" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D94C7E" />
            <Setter Property="BorderThickness" Value="0,0,0,5" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24,15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource CuteJapaneseFont}" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Background" Value="#FFF2F5" />
            <Setter Property="Foreground" Value="#734A62" />
            <Setter Property="BorderBrush" Value="#F4CFDA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontFamily" Value="{StaticResource CuteJapaneseFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Storyboard x:Name="TickStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.93" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FakeStopStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="Rotation">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="-9" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.46" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="DecoyBadge" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DecoyBadgeTransform" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DecoyBadgeTransform" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><BackEase Amplitude="0.8" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="SneakStoryboard">
            <DoubleAnimation Storyboard.TargetName="DecoyBadge" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="BunnyEyes" Storyboard.TargetProperty="X"
                             To="-6" Duration="0:0:0.18" />
            <DoubleAnimation Storyboard.TargetName="BunnySweat" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.2" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BunnySweatShift" Storyboard.TargetProperty="Y"
                                           RepeatBehavior="3x">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.6" Value="7" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SneakyPaw" Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="SneakyPawShift" Storyboard.TargetProperty="X"
                             From="60" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="NudgeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="TranslateX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction><ElasticEase Oscillations="2" Springiness="4" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="Rotation">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-7" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SneakyPawShift" Storyboard.TargetProperty="X">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-22" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.26" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="RevealStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="ScaleX">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="ScaleY">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.7" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction><ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="Rotation"
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="BallTransform" Storyboard.TargetProperty="TranslateX"
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="HaloRing" Storyboard.TargetProperty="Opacity"
                             From="0.9" To="0" Duration="0:0:0.7" />
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.8" To="1.35" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.8" To="1.35" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DecoyBadge" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.1" />
            <DoubleAnimation Storyboard.TargetName="SneakyPaw" Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="BunnySweat" Storyboard.TargetProperty="Opacity"
                             BeginTime="0:0:1.4" To="0" Duration="0:0:0.4" />
            <DoubleAnimation Storyboard.TargetName="BunnyEyes" Storyboard.TargetProperty="X"
                             BeginTime="0:0:1.4" To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="Whistle" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2" AutoReverse="True" RepeatBehavior="0:0:1.6" />
            <DoubleAnimation Storyboard.TargetName="WhistleShift" Storyboard.TargetProperty="Y"
                             From="4" To="-8" Duration="0:0:0.8" RepeatBehavior="2x" />
        </Storyboard>
        <DataTemplate x:Key="BoardLetterTemplate" x:DataType="vm:BingoRowViewModel">
            <Border Background="{x:Bind Background}" CornerRadius="13">
                <TextBlock Text="{x:Bind Letter}" Foreground="{x:Bind Foreground}"
                           FontFamily="{StaticResource CuteNumberFont}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BoardNumberTemplate" x:DataType="vm:BingoCellViewModel">
            <Border Background="{x:Bind Background, Mode=OneWay}"
                    BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
                    BorderThickness="2" CornerRadius="12">
                <Grid>
                    <TextBlock Text="{x:Bind NumberText}"
                               AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                               Foreground="{x:Bind Foreground, Mode=OneWay}"
                               FontFamily="{StaticResource CuteNumberFont}" FontSize="18"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="♥" FontSize="11" Foreground="#E5578A"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-3,-1,0" AutomationProperties.AccessibilityView="Raw"
                               Visibility="{x:Bind StampVisibility, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="LayoutViewport" SizeChanged="OnViewportSizeChanged">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF1F6" Offset="0" />
                <GradientStop Color="#FFF8F3" Offset="0.58" />
                <GradientStop Color="#F2F9F5" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Canvas IsHitTestVisible="False" Opacity="0.55">
            <TextBlock Canvas.Left="30" Canvas.Top="132" Text="✦" FontSize="26" Foreground="#F3A8BF" />
            <TextBlock Canvas.Left="465" Canvas.Top="18" Text="♡" FontSize="25" Foreground="#F1A2BC" />
            <TextBlock Canvas.Left="1100" Canvas.Top="130" Text="✧" FontSize="30" Foreground="#E8B94F" />
            <TextBlock Canvas.Left="1220" Canvas.Top="600" Text="♡" FontSize="30" Foreground="#B9DFCB" />
            <TextBlock Canvas.Left="80" Canvas.Top="705" Text="✦" FontSize="22" Foreground="#D8C1F8" />
        </Canvas>

        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid x:Name="ContentSurface" Width="1280" Height="720" Padding="20,12,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="✿" FontSize="33" Foreground="#EB6A99" VerticalAlignment="Center" />
                                <TextBlock Text="BINGO PARTY!" FontFamily="{StaticResource CuteNumberFont}"
                                           FontSize="38" FontWeight="Bold" Foreground="#66445D" />
                            </StackPanel>
                            <TextBlock Text="みんなで どきどき、ビンゴじかん。" FontFamily="{StaticResource CuteJapaneseFont}"
                                       FontSize="13" Foreground="#79596D" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#FFFFFFFF" CornerRadius="18"
                                    Padding="16,9" VerticalAlignment="Center" BorderBrush="#F7D5DF" BorderThickness="1">
                                <TextBlock Text="♡  1 〜 75 の おたのしみ" FontFamily="{StaticResource CuteJapaneseFont}"
                                           FontSize="12" Foreground="#8A536D" />
                            </Border>
                            <Button x:Name="FullScreenButton" Style="{StaticResource SmallButtonStyle}" Click="OnFullScreenClick"
                                    AutomationProperties.Name="全画面"
                                    ToolTipService.ToolTip="全画面表示の切り替え (F11)。Esc で元に戻ります。">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FullScreenLabel" Text="全画面" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ErrorPanel" Grid.Row="1" Margin="0,0,0,14"
                            Background="#FFF1E9" BorderBrush="#E7A47D" BorderThickness="1"
                            SizeChanged="OnErrorPanelSizeChanged"
                            CornerRadius="16" Padding="16,12" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                       Foreground="#79412E" TextWrapping="Wrap" />
                            <Button Content="もう一度読み込む" Command="{x:Bind ViewModel.RetryCommand}"
                                    Visibility="{x:Bind ViewModel.RetryVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="MainContent" Grid.Row="2" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="StageColumn" Width="*" />
                            <ColumnDefinition x:Name="BoardColumn" Width="2.15*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="StageRow" Height="*" />
                            <RowDefinition x:Name="BoardRow" Height="0" />
                        </Grid.RowDefinitions>

                        <Border Background="#FFFFFCFD" BorderBrush="#FFF" BorderThickness="3"
                                CornerRadius="32" Padding="22,18,22,20" MinHeight="530">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="75" Height="79" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Width="22" Height="47" Fill="White" Stroke="#EFB7C8" StrokeThickness="2"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0">
                                            <Ellipse.RenderTransform><RotateTransform Angle="-15" CenterX="11" CenterY="24" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="22" Height="47" Fill="White" Stroke="#EFB7C8" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,10,0">
                                            <Ellipse.RenderTransform><RotateTransform Angle="15" CenterX="11" CenterY="24" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="30" Fill="#FFD5E1" HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" Margin="17,6,0,0">
                                            <Ellipse.RenderTransform><RotateTransform Angle="-15" CenterX="5" CenterY="15" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="10" Height="30" Fill="#FFD5E1" HorizontalAlignment="Right"
                                                 VerticalAlignment="Top" Margin="0,6,17,0">
                                            <Ellipse.RenderTransform><RotateTransform Angle="15" CenterX="5" CenterY="15" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="66" Height="56" Fill="White" Stroke="#EFB7C8" StrokeThickness="2"
                                                 VerticalAlignment="Bottom" />
                                        <Grid>
                                            <Grid.RenderTransform><TranslateTransform x:Name="BunnyEyes" /></Grid.RenderTransform>
                                            <Ellipse Width="5" Height="7" Fill="#65485B" HorizontalAlignment="Left"
                                                     VerticalAlignment="Bottom" Margin="22,0,0,26" />
                                            <Ellipse Width="5" Height="7" Fill="#65485B" HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom" Margin="0,0,22,26" />
                                        </Grid>
                                        <Ellipse Width="10" Height="6" Fill="#FFAFC6" HorizontalAlignment="Left"
                                                 VerticalAlignment="Bottom" Margin="12,0,0,17" />
                                        <Ellipse Width="10" Height="6" Fill="#FFAFC6" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,12,17" />
                                        <TextBlock Text="ᴗ" FontSize="18" Foreground="#A3637D"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                                        <Path x:Name="BunnySweat" Opacity="0" Fill="#9FD3F2" Stroke="#6FB6E2" StrokeThickness="1"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,34"
                                              Data="M 6,0 C 6,0 12,8 12,12 A 6,6 0 1 1 0,12 C 0,8 6,0 6,0 Z">
                                            <Path.RenderTransform><TranslateTransform x:Name="BunnySweatShift" /></Path.RenderTransform>
                                        </Path>
                                        <TextBlock x:Name="Whistle" Text="♪" Opacity="0" FontSize="17" Foreground="#E7759F"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,6">
                                            <TextBlock.RenderTransform><TranslateTransform x:Name="WhistleShift" /></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <Border Grid.Column="1" Background="#FFF1F5" CornerRadius="20,20,20,4"
                                            Padding="15,12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                                                   FontFamily="{StaticResource CuteJapaneseFont}" FontSize="14"
                                                   Foreground="#704B60" TextWrapping="Wrap" />
                                    </Border>
                                </Grid>

                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="12,10,12,10">
                                    <Grid Width="260" Height="260">
                                        <Ellipse Width="252" Height="252" Fill="#FFF2C9" />
                                        <Ellipse Width="232" Height="232" Fill="#FFF8E8" />
                                        <TextBlock Text="✦" FontSize="26" Foreground="#F3B44E"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,24,0,0" />
                                        <TextBlock Text="✦" FontSize="22" Foreground="#ED8FB3"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,31" />
                                        <Ellipse x:Name="HaloRing" Width="240" Height="240" Opacity="0"
                                                 Stroke="#F7A8C4" StrokeThickness="6" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" /></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Grid Width="220" Height="220">
                                            <Grid.RenderTransform>
                                                <CompositeTransform x:Name="BallTransform" CenterX="110" CenterY="110" />
                                            </Grid.RenderTransform>
                                            <Border Background="#EECBD4" CornerRadius="110" Margin="0,7,0,0" />
                                            <Border Background="{x:Bind ViewModel.CurrentBallBrush, Mode=OneWay}"
                                                    BorderBrush="White" BorderThickness="5" CornerRadius="110" Margin="0,0,0,7">
                                                <Grid>
                                                    <Ellipse Width="170" Height="170" Fill="#FFFFFCFD" />
                                                    <Ellipse Width="90" Height="19" Fill="#66FFFFFF"
                                                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" />
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-8">
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentLetter, Mode=OneWay}"
                                                                   FontFamily="{StaticResource CuteNumberFont}" FontSize="27" FontWeight="Bold"
                                                                   Foreground="#D56B95" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="CurrentBallText" Text="{x:Bind ViewModel.CurrentNumberText, Mode=OneWay}"
                                                                   AutomationProperties.Name="{x:Bind ViewModel.CurrentNumberDescription, Mode=OneWay}"
                                                                   AutomationProperties.LiveSetting="Polite"
                                                                   FontFamily="{StaticResource CuteNumberFont}" FontSize="88" FontWeight="Bold"
                                                                   Foreground="#60465C" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <Border x:Name="DecoyBadge" Opacity="0" Background="#FFFFFF" BorderBrush="#F2A92E"
                                                BorderThickness="2" CornerRadius="14" Padding="10,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,4,0,0"
                                                RenderTransformOrigin="0.5,0.5" AutomationProperties.AccessibilityView="Raw">
                                            <Border.RenderTransform>
                                                <CompositeTransform x:Name="DecoyBadgeTransform" Rotation="-10" />
                                            </Border.RenderTransform>
                                            <TextBlock Text="けってい…？" FontFamily="{StaticResource CuteJapaneseFont}"
                                                       FontSize="13" Foreground="#9A6414" />
                                        </Border>
                                        <Grid x:Name="SneakyPaw" Opacity="0" Width="66" Height="66"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-34,0"
                                              AutomationProperties.AccessibilityView="Raw">
                                            <Grid.RenderTransform><TranslateTransform x:Name="SneakyPawShift" /></Grid.RenderTransform>
                                            <Ellipse Width="42" Height="38" Fill="White" Stroke="#EFB7C8" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,8" />
                                            <Ellipse Width="14" Height="11" Fill="#FFB9CD"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" />
                                            <Ellipse Width="8" Height="8" Fill="#FFB9CD"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,31" />
                                            <Ellipse Width="8" Height="8" Fill="#FFB9CD"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,36" />
                                            <Ellipse Width="8" Height="8" Fill="#FFB9CD"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,31" />
                                        </Grid>
                                        <Grid Width="260" Height="260" IsHitTestVisible="False"
                                              AutomationProperties.AccessibilityView="Raw">
                                            <Path x:Name="TrickBeam" Opacity="0" Fill="#A9E9F7"
                                                  Data="M 75,18 L 185,18 L 236,235 L 24,235 Z" />
                                            <Ellipse x:Name="TrickRing" Width="242" Height="242" Opacity="0"
                                                     Stroke="#F3A8BF" StrokeThickness="6" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform x:Name="TrickRingScale" /></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <TextBlock x:Name="TrickSymbol" Opacity="0" FontFamily="Segoe UI Emoji"
                                                       FontSize="76" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><CompositeTransform x:Name="TrickSymbolTransform" /></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <Border x:Name="TrickBadge" Opacity="0" Background="#FFFFFCFD"
                                                    BorderBrush="#E9A3BD" BorderThickness="2" CornerRadius="14"
                                                    Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,3,-12,0" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform><ScaleTransform x:Name="TrickBadgeScale" /></Border.RenderTransform>
                                                <TextBlock x:Name="TrickBadgeText" FontFamily="{StaticResource CuteJapaneseFont}"
                                                           FontSize="11" Foreground="#8A4364" />
                                            </Border>
                                        </Grid>
                                        <Canvas x:Name="ConfettiLayer" Width="260" Height="260" IsHitTestVisible="False"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Viewbox>

                                <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.CurrentBallCaption, Mode=OneWay}" FontFamily="{StaticResource CuteJapaneseFont}"
                                           FontSize="13" Foreground="#79596D" HorizontalAlignment="Center" />
                                <Button Grid.Row="3" Command="{x:Bind ViewModel.DrawCommand}" Style="{StaticResource DrawButtonStyle}"
                                        HorizontalAlignment="Stretch" MinHeight="64"
                                        AutomationProperties.Name="{x:Bind ViewModel.DrawButtonText, Mode=OneWay}">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F375A1" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D94C7E" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FAD3E1" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#A0446B" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#EE9DBB" />
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                        <TextBlock Text="♥" FontSize="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.DrawButtonText, Mode=OneWay}" />
                                        <TextBlock Text="♥" FontSize="20" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="4" Spacing="8">
                                    <TextBlock Text="さっき でた ばんごう" FontFamily="{StaticResource CuteJapaneseFont}"
                                               FontSize="12" Foreground="#79596D" />
                                    <TextBlock Text="まだ ないよ ♡" FontFamily="{StaticResource CuteJapaneseFont}"
                                               FontSize="12" Foreground="#846C7B"
                                               Visibility="{x:Bind ViewModel.EmptyRecentVisibility, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentNumbers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RecentNumberViewModel">
                                                <Border Background="{x:Bind Background}" CornerRadius="12" Padding="8,5" Margin="0,0,5,0">
                                                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Foreground}"
                                                               FontFamily="{StaticResource CuteNumberFont}" FontSize="13" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="BoardPanel" Grid.Column="1" Background="#FFFFFCFD"
                                BorderBrush="White" BorderThickness="3" CornerRadius="32" Padding="22,22,22,20">
                            <Grid RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="✿" FontSize="23" Foreground="#EA779F" />
                                            <TextBlock Text="ばんごうボード" FontFamily="{StaticResource CuteJapaneseFont}"
                                                       FontSize="21" Foreground="#60465C" />
                                        </StackPanel>
                                        <TextBlock Text="でた ばんごうに いろが つくよ" FontFamily="{StaticResource CuteJapaneseFont}"
                                                   FontSize="12" Foreground="#79596D" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#FFF0F5" CornerRadius="18" Padding="14,8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                                                   FontFamily="{StaticResource CuteNumberFont}" FontSize="20" FontWeight="Bold"
                                                   Foreground="#A0446B" />
                                    </Border>
                                </Grid>

                                <Grid x:Name="NumberBoard" Grid.Row="1" ColumnSpacing="4" RowSpacing="7" />

                                <StackPanel Grid.Row="2" Spacing="8">
                                    <Grid>
                                        <TextBlock Text="みんなの ビンゴメーター" FontFamily="{StaticResource CuteJapaneseFont}"
                                                   FontSize="12" Foreground="#79596D" />
                                        <TextBlock Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}"
                                                   FontFamily="{StaticResource CuteJapaneseFont}" FontSize="12"
                                                   Foreground="#A0446B" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Border Background="#F8E8ED" CornerRadius="6" Height="12">
                                        <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="75"
                                                     Foreground="#EC79A2" Background="Transparent" Height="12"
                                                     AutomationProperties.Name="抽選済みの番号の数" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="3" Height="1" Background="#F5E5EA" />
                                <Grid Grid.Row="4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SmallButtonStyle}" Command="{x:Bind ViewModel.UndoCommand}"
                                            Content="↶ ひとつ もどす" HorizontalAlignment="Left" />
                                    <Button Grid.Column="1" Style="{StaticResource SmallButtonStyle}"
                                            Content="はじめから" IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}"
                                            Click="OnResetClick" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</Page>
