<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KawaiiBingo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="かわいいビンゴ">
    <Grid Background="#FFF4F6">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="かわいいビンゴ" Background="Transparent" />
        <ContentPresenter x:Name="PageHost" Grid.Row="1" />
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnExitFullScreenAccelerator" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
